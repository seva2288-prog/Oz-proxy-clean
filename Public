        class QuantumAI {
            constructor() {
                this.model = null;
                this.isTraining = false;
                this.accuracy = 0;
                this.initialized = false;
                this.trainingHistory = [];
            }

            async init() {
                if (this.initialized) return this;
                try {
                    await this.loadModel();
                } catch (e) {
                    console.log('AI не загружен, будет создан при обучении');
                }
                this.initialized = true;
                updateAIStatus();
                return this;
            }

            prepareData(bets) {
                const features = [];
                const labels = [];
                
                bets.forEach(bet => {
                    if (bet.outcome === 'pending') return;
                    
                    features.push([
                        bet.home || 0,
                        bet.away || 0,
                        bet.bkLine || 0,
                        bet.confidence || 50,
                        parseFloat(bet.homeXG) || 0,
                        parseFloat(bet.awayXG) || 0,
                    ]);
                    
                    labels.push(bet.outcome === 'win' ? 1 : 0);
                });
                
                return { features, labels };
            }

            async createModel() {
                if (this.model) return this.model;
                
                const model = tf.sequential();
                
                model.add(tf.layers.dense({
                    units: 32,
                    activation: 'relu',
                    inputShape: [6]
                }));
                
                model.add(tf.layers.dense({
                    units: 16,
                    activation: 'relu'
                }));
                
                model.add(tf.layers.dropout({ rate: 0.2 }));
                
                model.add(tf.layers.dense({
                    units: 1,
                    activation: 'sigmoid'
                }));
                
                model.compile({
                    optimizer: tf.train.adam(0.001),
                    loss: 'binaryCrossentropy',
                    metrics: ['accuracy']
                });
                
                this.model = model;
                return model;
            }

            async train(bets, epochs = 100, onProgress = null) {
                if (bets.length < 10) {
                    showToast('⚠️ Нужно минимум 10 ставок с известным исходом', 'error');
                    return false;
                }

                this.isTraining = true;
                updateAIStatus();
                showToast('🧠 Обучение AI началось...', 'info');

                try {
                    const { features, labels } = this.prepareData(bets);
                    
                    if (features.length === 0) {
                        showToast('⚠️ Нет данных для обучения', 'error');
                        this.isTraining = false;
                        return false;
                    }

                    await this.createModel();

                    const xs = tf.tensor2d(features);
                    const ys = tf.tensor2d(labels, [labels.length, 1]);

                    const history = await this.model.fit(xs, ys, {
                        epochs: epochs,
                        batchSize: Math.min(32, features.length),
                        validationSplit: 0.2,
                        callbacks: {
                            onEpochEnd: (epoch, logs) => {
                                if (epoch % 10 === 0 || epoch === epochs - 1) {
                                    const msg = `Epoch ${epoch+1}/${epochs}: loss=${logs.loss.toFixed(4)}, acc=${logs.acc.toFixed(4)}`;
                                    console.log(msg);
                                    this.accuracy = logs.acc;
                                    if (onProgress) onProgress(msg);
                                    addAILog(msg);
                                }
                            }
                        }
                    });

                    this.accuracy = history.history.acc[history.history.acc.length - 1] || 0;
                    await this.saveModel();
                    
                    this.isTraining = false;
                    updateAIStatus();
                    showToast(`✅ AI обучен! Точность: ${Math.round(this.accuracy * 100)}%`, 'success');
                    return true;

                } catch (error) {
                    console.error('Train error:', error);
                    showToast('⚠️ Ошибка обучения: ' + error.message, 'error');
                    this.isTraining = false;
                    updateAIStatus();
                    return false;
                }
            }

