            if (newOutcome === '1') { b.outcome = 'win'; b.resultText = '✅ Выигрыш'; }
            else if (newOutcome === '2') { b.outcome = 'loss'; b.resultText = '❌ Проигрыш'; }
            else { b.outcome = 'pending'; b.resultText = '⏳ Ожидание'; }
            localStorage.setItem('quantum_bets', JSON.stringify(state.bets));
            renderHistory();
            renderStats();
            renderDashboard();
            renderChart();
            renderInsights();
            updateAIStatus();
            showToast('✅ Обновлено', 'success');
        }
        
        function clearHistory() {
            if (!confirm('Удалить всю историю?')) return;
            state.bets = [];
            localStorage.setItem('quantum_bets', JSON.stringify(state.bets));
            renderHistory();
            renderStats();
            renderDashboard();
            renderChart();
            renderInsights();
            updateAIStatus();
            showToast('🗑️ История очищена', 'success');
        }
        
        function resetAll() {
            if (!confirm('Сбросить все данные?')) return;
            localStorage.clear();
            location.reload();
        }
        
        function renderHistory() {
            const list = $('historyList');
            if (!list) return;
            if (state.bets.length === 0) {
                list.innerHTML = '<div class="text-muted text-center" style="padding:10px 0;">Нет ставок</div>';
                return;
            }
            const modeNames = { 'total': 'Тотал', 'fora': 'Фора', 'oz': 'ОЗ' };
            list.innerHTML = state.bets.slice().reverse().map((b, i) => {
                const idx = state.bets.length - 1 - i;
                const cls = b.outcome === 'win' ? 'win' : (b.outcome === 'loss' ? 'loss' : 'pending');
                const emoji = b.outcome === 'win' ? '✅' : (b.outcome === 'loss' ? '❌' : '⏳');
                return `<div class="history-item" onclick="editBet(${idx})">
                    <div><b>${modeNames[b.mode] || b.mode}</b>: ${b.value}</div>
                    <div><span class="${cls}">${emoji} ${b.resultText || '⏳'}</span></div>
                </div>`;
            }).join('');
        }
        
        function renderStats() {
            const total = state.bets.length;
            const wins = state.bets.filter(b => b.outcome === 'win').length;
            const losses = state.bets.filter(b => b.outcome === 'loss').length;
            if ($('statTotal')) $('statTotal').textContent = total;
            if ($('statWinRate')) $('statWinRate').textContent = (wins + losses) > 0 ? Math.round((wins / (wins + losses)) * 100) + '%' : '0%';
            if ($('statBalance')) $('statBalance').textContent = wins - losses;
            if ($('statROI')) $('statROI').textContent = total > 0 ? Math.round(((wins - losses) / total) * 100) + '%' : '0%';
        }
        
        function renderDashboard() {
            const total = state.bets.length;
            const wins = state.bets.filter(b => b.outcome === 'win').length;
            const losses = state.bets.filter(b => b.outcome === 'loss').length;
            let streak = 0, maxStreak = 0;
            for (let i = state.bets.length - 1; i >= 0; i--) {
                if (state.bets[i].outcome === 'win') { streak++; maxStreak = Math.max(maxStreak, streak); }
                else if (state.bets[i].outcome === 'loss') streak = 0;
                else break;
            }
            if ($('kpiTotal')) $('kpiTotal').textContent = total;
            if ($('kpiWinRate')) $('kpiWinRate').textContent = (wins + losses) > 0 ? Math.round((wins / (wins + losses)) * 100) + '%' : '0%';
            if ($('kpiProfit')) $('kpiProfit').textContent = wins - losses;
            if ($('kpiROI')) $('kpiROI').textContent = total > 0 ? Math.round(((wins - losses) / total) * 100) + '%' : '0%';
            if ($('kpiStreak')) $('kpiStreak').textContent = streak;
            if ($('kpiBest')) $('kpiBest').textContent = maxStreak;
        }
        
        function renderChart() {
            const chart = $('chartBars');
            if (!chart) return;
            const last20 = state.bets.slice(-20);
            let bal = 0;
            const data = last20.map(b => {
                if (b.outcome === 'win') bal++;
                else if (b.outcome === 'loss') bal--;
                return bal;
            });
            if (data.length === 0) {
                chart.innerHTML = '<span style="color:#888;font-size:11px;">Нет данных</span>';
                return;
            }
            const max = Math.max(1, ...data.map(Math.abs));
            chart.innerHTML = data.map(v =>
                `<div class="bar ${v < 0 ? 'loss' : ''}" style="height:${Math.max(3, (Math.abs(v) / max) * 26)}px;"></div>`
            ).join('');
        }
        
        function renderInsights() {
            const container = $('insightsContent');
            if (!container) return;
            if (state.bets.length === 0) {
                container.innerHTML = '<div class="text-muted text-center" style="padding:6px 0;">Нет данных</div>';
                return;
            }
            const wins = state.bets.filter(b => b.outcome === 'win').length;
            const rate = Math.round((wins / state.bets.length) * 100);
            container.innerHTML = `<div style="font-size:12px;">📊 Всего ставок: ${state.bets.length}, побед: ${wins} (${rate}%)</div>`;
        }
        
        function clearAll() {
            if ($('homeGoals')) $('homeGoals').value = '0';
            if ($('awayGoals')) $('awayGoals').value = '0';
            if ($('bkLine')) { $('bkLine').value = '0'; $('bkLine').disabled = true; }
            if ($('sumDisplay')) $('sumDisplay').textContent = '0';
            if ($('resValue1')) $('resValue1').textContent = '--';
            if ($('resValue2')) $('resValue2').textContent = '--';
            if ($('resValue3')) $('resValue3').textContent = '--';
            const adv = $('resAdvice');
            if (adv) { adv.textContent = '⏳ Введите данные для расчёта'; adv.className = 'advice info'; }
            if ($('confidenceLabel')) $('confidenceLabel').textContent = '0%';
            if ($('confidenceFill')) $('confidenceFill').style.width = '0%';
            if ($('h2hResults')) $('h2hResults').innerHTML = '';
            if ($('h2hStatus')) $('h2hStatus').textContent = 'Введите команды и нажмите "Загрузить H2H"';
            state.h2hData = null;
            state.understatData = null;
            state.currentOdds = null;
            state.aiPredictedScore = null;
            stopLiveUpdates();
            if ($('xgCard')) $('xgCard').style.display = 'none';
            if ($('aiCard')) $('aiCard').style.display = 'none';
            if ($('liveCard')) $('liveCard').style.display = 'none';
            if ($('aiResult')) $('aiResult').style.display = 'none';
            if ($('contextCard')) $('contextCard').style.display = 'none';
            if ($('bkComment')) { $('bkComment').textContent = '—'; $('bkComment').style.background = 'transparent'; }
            if ($('searchBadge')) $('searchBadge').style.display = 'none';
            showToast('🗑️ Очищено', 'info');
        }
        
        function exportData() {
            const data = { bets: state.bets, version: '2.3 AI', exportDate: new Date().toISOString() };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `quantum_backup_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('📦 Данные экспортированы!', 'success');
        }
        
        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.bets && Array.isArray(data.bets)) {
                        state.bets = data.bets;
                        localStorage.setItem('quantum_bets', JSON.stringify(state.bets));
                        renderHistory();
                        renderStats();
                        renderDashboard();
                        renderChart();
                        renderInsights();
                        updateAIStatus();
                        showToast('📥 Данные импортированы!', 'success');
                    } else showToast('❌ Неверный формат файла', 'error');
                } catch (err) { showToast('❌ Ошибка импорта', 'error'); }
            };
            reader.readAsText(file);
            event.target.value = '';
        }
        
        function renderLeagues() {
            const select = document.getElementById('leagueSelect');
            if (!select) return;
            select.innerHTML = '';
            Object.keys(LEAGUES).forEach(key => {
                const option = document.createElement('option');
                option.value = key;
                option.textContent = LEAGUES[key].name;
                if (key === state.currentLeague) option.selected = true;
                select.appendChild(option);
            });
            updateLeagueInfo();
        }
        
        function updateLeagueInfo() {
            const league = getLeague();
            const badge = document.getElementById('autoLeagueBadge');
            if (badge) badge.innerHTML = `<span class="league-badge">${league.country}</span>`;
            const info = document.getElementById('leagueInfo');
            if (info) info.textContent = `Ср. тотал: ${league.avgGoals} | ОЗ: ${league.oz}%`;
        }
        
        function renderSettingsLeagues() {
            const select = document.getElementById('settingsLeagueSelect');
            if (!select) return;
            select.innerHTML = '';
            Object.keys(LEAGUES).forEach(key => {
                const option = document.createElement('option');
                option.value = key;
                option.textContent = LEAGUES[key].name;
                if (key === state.currentLeague) option.selected = true;
                select.appendChild(option);
            });
        }
        
        function changeDefaultLeague(value) {
            state.currentLeague = value;
            localStorage.setItem('quantum_league', value);
            if (document.getElementById('leagueSelect')) document.getElementById('leagueSelect').value = value;
            updateLeagueInfo();
            showToast(`🏆 Лига изменена: ${LEAGUES[value].name}`, 'success');
        }
        
        function switchMode(mode, btn) {
            state.currentMode = mode;
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            const labels = { 'total': 'Ожидаемый тотал', 'fora': 'Ожидаемая фора', 'oz': 'Обе забьют' };
            const label1 = document.getElementById('resLabel1');
            if (label1) label1.textContent = labels[mode] || 'Ожидаемый';
            const v1 = document.getElementById('resValue1');
            if (v1) v1.textContent = '--';
            const v2 = document.getElementById('resValue2');
            if (v2) v2.textContent = '--';
            const v3 = document.getElementById('resValue3');
            if (v3) v3.textContent = '--';
            const adv = document.getElementById('resAdvice');
            if (adv) { adv.textContent = '⏳ Введите данные для расчёта'; adv.className = 'advice info'; }
            const cl = document.getElementById('confidenceLabel');
            if (cl) cl.textContent = '0%';
            const cf = document.getElementById('confidenceFill');
            if (cf) cf.style.width = '0%';
        }
        
        async function generateAIPrediction() {
            console.log('generateAIPrediction вызван');
            showToast('🧠 AI прогноз генерируется...', 'info');
            setTimeout(() => {
                document.getElementById('aiResult').style.display = 'block';
                document.getElementById('aiRecommendation').textContent = '✅ Тотал БОЛЬШЕ 2.5';
                document.getElementById('aiAdvice').textContent = '📊 Прогноз на основе общей статистики';
                showToast('✅ AI прогноз готов!', 'success');
            }, 1500);
        }
    </script>
</body>
</html>

