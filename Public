        async function enhanceWithML(predictedHome, predictedAway, bkLine, confidence) {
            if (!quantumAI.isTrained()) return confidence;
            
            const features = [
                predictedHome || 0,
                predictedAway || 0,
                bkLine || 0,
                confidence || 50,
                parseFloat(state.understatData?.homeXG || 0),
                parseFloat(state.understatData?.awayXG || 0)
            ];
            
            const mlPrediction = await quantumAI.predict(features);
            
            if (mlPrediction !== null && mlPrediction >= 0 && mlPrediction <= 1) {
                const mlWeight = Math.min(0.4, 0.1 + (quantumAI.accuracy * 0.3));
                const currentProb = confidence / 100;
                const blendedProb = currentProb * (1 - mlWeight) + mlPrediction * mlWeight;
                const newConfidence = Math.round(Math.max(0, Math.min(100, blendedProb * 100)));
                
                const mlSection = document.getElementById('mlSection');
                const mlDisplay = document.getElementById('aiMLConfidence');
                if (mlSection) mlSection.style.display = 'block';
                if (mlDisplay) {
                    mlDisplay.textContent = `${Math.round(mlPrediction * 100)}% (вес ${Math.round(mlWeight * 100)}%)`;
                    mlDisplay.style.color = mlPrediction > 0.6 ? '#2ecc71' : '#f1c40f';
                }
                
                return newConfidence;
            }
            
            return confidence;
        }

